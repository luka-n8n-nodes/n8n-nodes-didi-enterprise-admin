{
	"name": "@luka-cat-mimi/n8n-nodes-didi-enterprise-admin",
	"version": "0.1.1",
	"description": "滴滴企业版管理后台 N8N 节点，支持部门/项目与员工管理",
	"keywords": [
		"n8n",
		"n8n-node",
		"n8n-community-node-package",
		"didi",
		"滴滴",
		"滴滴企业版"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"homepage": "https://github.com/luka-n8n-nodes/n8n-nodes-didi-enterprise-admin#readme",
	"author": {
		"name": "luka-cat",
		"email": "luka.cat.mimi@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/luka-n8n-nodes/n8n-nodes-didi-enterprise-admin.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier credentials nodes --write",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test:crypto": "node scripts/verify-crypto.cjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/DidiEnterpriseAdminApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DidiEnterpriseAdmin/DidiEnterpriseAdmin.node.js"
		],
		"strict": false
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^20.19.43",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"glob": "^13.0.6"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
